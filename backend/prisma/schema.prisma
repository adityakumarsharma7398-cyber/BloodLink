  compatibility_rules_compatibility_rules_donor_blood_group_idToblood_groups     compatibility_rules[] @relation("compatibility_rules_donor_blood_group_idToblood_groups")
  compatibility_rules_compatibility_rules_recipient_blood_group_idToblood_groups compatibility_rules[] @relation("compatibility_rules_recipient_blood_group_idToblood_groups")
  donor_activations                                                              donor_activations[]
  donors                                                                         donors[]
  inventory_units                                                                inventory_units[]
  planning_parameters                                                            planning_parameters[]
  predictions                                                                    predictions[]
  request_items                                                                  request_items[]
  transactions                                                                   transactions[]
  transfers                                                                      transfers[]

  @@schema("public")
}

