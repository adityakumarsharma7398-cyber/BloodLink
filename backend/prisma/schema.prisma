generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "public"]
}

model auth_users {
  id    String        @id @db.Uuid
  email String?
  users public_users?

  @@map("users")
  @@schema("auth")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model alerts {
  id                                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id                     String           @db.Uuid
  facility_id                         String?          @db.Uuid
  alert_type                          alert_type
  severity                            risk_level
  title                               String
  message                             String
  source_prediction_id                String?          @db.Uuid
  recommendation_id                   String?          @db.Uuid
  request_id                          String?          @db.Uuid
  transfer_id                         String?          @db.Uuid
  dedupe_key                          String?
  status                              alert_status     @default(UNREAD)
  acknowledged_by                     String?          @db.Uuid
  acknowledged_at                     DateTime?        @db.Timestamptz(6)
  resolved_by                         String?          @db.Uuid
  resolved_at                         DateTime?        @db.Timestamptz(6)
  created_at                          DateTime         @default(now()) @db.Timestamptz(6)
  users_alerts_acknowledged_byTousers public_users?    @relation("alerts_acknowledged_byTousers", fields: [acknowledged_by], references: [id], onUpdate: NoAction)
  facilities                          facilities?      @relation(fields: [facility_id, organization_id], references: [id, organization_id], onUpdate: NoAction, map: "alerts_facility_in_org")
  organizations                       organizations    @relation(fields: [organization_id], references: [id], onUpdate: NoAction)
  recommendations                     recommendations? @relation(fields: [recommendation_id], references: [id], onUpdate: NoAction)
  requests                            requests?        @relation(fields: [request_id], references: [id], onUpdate: NoAction)
  users_alerts_resolved_byTousers     public_users?    @relation("alerts_resolved_byTousers", fields: [resolved_by], references: [id], onUpdate: NoAction)
  predictions                         predictions?     @relation(fields: [source_prediction_id], references: [id], onUpdate: NoAction)
  transfers                           transfers?       @relation(fields: [transfer_id], references: [id], onUpdate: NoAction)

  @@unique([organization_id, dedupe_key], map: "alerts_one_open_per_subject", where: raw("(status <> 'RESOLVED'::alert_status)"))
  @@index([organization_id, status, created_at(sort: Desc)], map: "alerts_org_status_created_idx")
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_logs {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurred_at     DateTime @default(now()) @db.Timestamptz(6)
  user_id         String?  @db.Uuid
  organization_id String?  @db.Uuid
  facility_id     String?  @db.Uuid
  action          String
  entity_type     String
  entity_id       String?  @db.Uuid
  old_value       Json?
  new_value       Json?
  ip_address      String?  @db.Inet
  correlation_id  String?  @db.Uuid

  @@index([entity_type, entity_id], map: "audit_logs_entity_idx")
  @@index([organization_id, occurred_at(sort: Desc)], map: "audit_logs_org_time_idx")
  @@index([user_id, occurred_at(sort: Desc)], map: "audit_logs_user_time_idx")
  @@schema("public")
}

