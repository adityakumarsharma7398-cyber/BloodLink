  users                                                                   public_users?          @relation(fields: [validated_by], references: [id], onUpdate: NoAction)

  @@unique([donor_blood_group_id, recipient_blood_group_id, component_id], map: "compatibility_rules_active_unique", where: raw("(validation_status <> 'RETIRED'::rule_validation_status)"))
  @@schema("public")
