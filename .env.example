# =============================================================================
# BloodLink AI — environment variables
# Copy to `.env` in the project root and fill in. Never commit `.env`.
#
# All three services read this single root file locally. In deployment, set the
# same variables on each platform (Vercel / Render / Railway).
#
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# NEVER put a service-role key or any server secret in a VITE_ variable.
# =============================================================================


# -----------------------------------------------------------------------------
# Frontend (public — bundled into the browser)
# -----------------------------------------------------------------------------

# Backend base URL. Leave as /api locally: Vite proxies /api -> BACKEND_PORT.
# In production set to the deployed backend, e.g. https://bloodlink-api.onrender.com/api
VITE_API_BASE_URL=/api

# Supabase project URL + anon (publishable) key. Safe for the browser; RLS protects data.
# Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Google Maps JavaScript API key for rendering maps in the browser.
# Must be HTTP-referrer restricted in Google Cloud. Empty = non-Google map fallback.
VITE_GOOGLE_MAPS_BROWSER_KEY=


# -----------------------------------------------------------------------------
# Backend — Node / Express (server-only)
# -----------------------------------------------------------------------------

NODE_ENV=development
BACKEND_PORT=4000

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# Supabase (server-side). The service-role key bypasses RLS: server only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection strings for Prisma (Supabase dashboard -> Connect).
# DATABASE_URL: transaction pooler (port 6543) with ?pgbouncer=true
# DIRECT_URL:   session pooler / direct connection (port 5432), used for introspection
DATABASE_URL=
DIRECT_URL=

# Python AI service location + shared secret (backend -> AI service only).
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=change-me-long-random-string

# Maps adapter: "mock" (Haversine distance + approximate ETA) or "google".
MAPS_PROVIDER=mock
# Server-side key for Routes API + Geocoding API. Required only when MAPS_PROVIDER=google.
GOOGLE_MAPS_SERVER_KEY=

# Notification adapter: "inapp" (Supabase Realtime / in-app) or "fcm".
NOTIFICATION_PROVIDER=inapp
# Firebase service-account credentials. Required only when NOTIFICATION_PROVIDER=fcm.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Keep literal \n sequences; the backend converts them to newlines.
FCM_PRIVATE_KEY=

# e-RaktKosh adapter: "mock" or "live". Live requires verified API access.
ERAKTKOSH_MODE=mock
ERAKTKOSH_API_BASE_URL=
ERAKTKOSH_API_KEY=

# -----------------------------------------------------------------------------
# Backend runtime (all optional; the defaults shown apply when unset)
# -----------------------------------------------------------------------------

# Database TLS: disable | require | verify (verify needs DATABASE_SSL_CA). Production refuses "disable".
# DATABASE_SSL=require
# DATABASE_SSL_CA=
# DATABASE_POOL_MAX=10

# Reverse proxies in front of the backend: "false" or a hop count (e.g. 1). Never "true".
# TRUST_PROXY=false
# REQUEST_TIMEOUT_MS=30000
# LOG_LEVEL=info

# Rate limits: public routes per IP per minute; 401 responses per IP per 15 minutes.
# RATE_LIMIT_PUBLIC_PER_MINUTE=120
# RATE_LIMIT_AUTH_FAILURES_PER_15_MIN=100

# Development only: allow DEMO_ONLY compatibility rules. Production refuses "true".
# ALLOW_DEMO_COMPATIBILITY_RULES=false


# -----------------------------------------------------------------------------
# AI service — Python / FastAPI (server-only)
# -----------------------------------------------------------------------------

AI_SERVICE_PORT=8000
# AI_SERVICE_API_KEY (above) is shared: the AI service rejects requests without it.
